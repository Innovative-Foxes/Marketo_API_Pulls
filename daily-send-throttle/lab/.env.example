# Copy to lab/.env and fill in.
#
# The FlowBoost PRIVATE key, from the signup email / dashboard. This is the
# only FlowBoost credential this project needs - no account login required.
# The PUBLIC key is for browser/landing-page use and is not used here.
#
# Your own free Community-tier key works fine for lab runs; swap in the
# production key before configuring the Marketo webhooks (README step 3).
# lab/.env is gitignored - do not commit a real key.
# Format: com:<32 chars>. The 'com:' prefix is part of the key - keep it.
FLOWBOOST_API_KEY=

# Endpoint, per the FlowBoost setup email. The literal $current is intentional -
# fb_lab.sh parses this file literally, so it is not expanded as a variable.
FLOWBOOST_URL=https://api.teknkl.com/flowboost$current/run?authoringEnv=pro
