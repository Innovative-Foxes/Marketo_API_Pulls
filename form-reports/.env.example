# Form reports — Marketo API credentials
# Copy this file to `.env` in THIS folder and fill in the values. `.env` is git-ignored.
#
# Where the values come from (Marketo Admin area):
#   1. Admin > Users & Roles > Roles > New Role. Under "Access API" tick (read-only):
#       - Read-Only Activity  (Fill Out Form activities, bulk activity export)
#       - Read-Only Asset     (forms, folders, programs, landing pages, static lists)
#       - Read-Only Person    (static-list membership — only for reply_list_report.py)
#   2. Admin > Users & Roles > Users > Invite New User: tick "API Only", assign that role.
#   3. Admin > Integration > LaunchPoint > New > New Service (type "Custom"), API Only
#      User = the user from step 2. Open it and choose "View Details" for the
#      Client ID and Client Secret.
#   4. Admin > Integration > Web Services > REST API > Endpoint is MARKETO_REST_BASE.
#      Use the host only, e.g. https://123-ABC-456.mktorest.com (drop any trailing /rest).

MARKETO_CLIENT_ID=your-client-id
MARKETO_CLIENT_SECRET=your-client-secret
MARKETO_REST_BASE=https://XXX-XXX-XXX.mktorest.com

# Optional. The host you see in your browser while logged in to Marketo,
# used only to build clickable links in outputs, e.g. https://app-ab12.marketo.com
# (optional) MARKETO_APP_BASE=https://app-abXX.marketo.com

# --- Optional tuning for the form reports -------------------------------------
# Names of YOUR hidden form fields that hold the page a form was filled out on
# (comma separated, best first). Tried before the built-in "Webpage URL" and
# "Referrer URL" attributes. Leave blank if you don't have such a field.
FORM_PAGE_URL_FIELDS=

# Your Adobe Experience Cloud tenant slug (the part after "@" in
# https://experience.adobe.com/#/@<tenant>/...). When set, landing-page links open
# the Marketo Engage UI inside Adobe Experience Cloud. Leave blank to use each
# landing page's public URL instead.
ADOBE_EXPERIENCE_TENANT=
